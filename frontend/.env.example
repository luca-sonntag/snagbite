# ==============================================================================
# FRONTEND — ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Complete reference of ALL supported Vite environment variables and defaults.
# Copy to `frontend/.env` for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API & SERVER CONNECTIONS
# ------------------------------------------------------------------------------
# Backend API origin. Leave EMPTY for local dev (uses Vite proxy to localhost:3000).
# In production, set to full URL (e.g. https://server.snagbite.app).
VITE_API_BASE_URL=

# Marketing & documentation website origin (default: http://localhost:5174)
VITE_WEBSITE_URL=http://localhost:5174

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SOCIAL LOGIN (Google OAuth)
# ------------------------------------------------------------------------------
# Google OAuth Web client ID (from Google Cloud Console).
# Used by native Google Sign-In on Android as the token audience / serverClientId.
VITE_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id

# ------------------------------------------------------------------------------
# 3. DEV TEST-USER & AUTO-LOGIN (Development only)
# ------------------------------------------------------------------------------
# Auto-login as seeded test user on startup (bypasses login screen, dev only)
VITE_TEST_LOGIN=false

# Seeded test user email address
VITE_TEST_USER_EMAIL=test@dev.snagbite.local

# Seeded test user password (keep in git-ignored frontend/.env.local)
VITE_TEST_USER_PASSWORD=

# ------------------------------------------------------------------------------
# 4. MONETIZATION — SUBSCRIPTIONS (RevenueCat)
# ------------------------------------------------------------------------------
# RevenueCat public Android API key (starts with goog_)
VITE_REVENUECAT_ANDROID_API_KEY=your_revenuecat_android_api_key

# ------------------------------------------------------------------------------
# 5. MONETIZATION — ADS (Google AdMob)
# ------------------------------------------------------------------------------
# Banner / MEDIUM_RECTANGLE ad unit ID for freemium extraction card.
# Leave EMPTY to serve Google's public TEST ads.
VITE_ADMOB_BANNER_ID=

# Rewarded video ad unit ID (empty = Google TEST rewarded video)
VITE_ADMOB_REWARDED_ID=

# Rewarded interstitial ad unit ID (5s skippable ad format, optional)
VITE_ADMOB_REWARDED_INTERSTITIAL_ID=

# Interstitial ad unit ID used for cold-start app-open & extraction interstitials.
# Leave EMPTY in production to disable if not configured.
VITE_ADMOB_INTERSTITIAL_ID=

# Comma-separated AdMob test-device IDs (serves safe test ads to registered physical devices)
VITE_ADMOB_TEST_DEVICES=

# Force Google's public TEST ad units (100% fill rate, safe for local testing).
# Set to 'true' during dev/test, 'false' in production.
VITE_ADMOB_USE_TEST_ADS=false

# Alternative test mode selector ('test' forces test units)
VITE_ADMOB_MODE=

# Force test mode specifically for rewarded ads ('true'/'false')
VITE_ADMOB_REWARDED_TEST_MODE=false

# ------------------------------------------------------------------------------
# 6. AD TIMING & FREQUENCY OVERRIDES (Dev / Testing)
# ------------------------------------------------------------------------------
# Minimum cooldown gap between two app-open ads in ms (default: 4h = 14400000)
# Override in .env.local (e.g. 5000) for instant testing in a single sitting
VITE_APP_OPEN_MIN_INTERVAL_MS=14400000

# Background duration before an app resume counts as an eligible "open" in ms (default: 4h = 14400000)
VITE_APP_OPEN_RESUME_MIN_BG_MS=14400000

# Minimum cooldown gap between two extraction fullscreen interstitial ads in ms (default: 2m = 120000)
VITE_EXTRACTION_INTERSTITIAL_MIN_INTERVAL_MS=120000
