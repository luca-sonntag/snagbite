# ==========================================
# API & SERVER CONNECTIONS
# ==========================================
# Backend API origin. Leave EMPTY for local dev (uses Vite proxy).
# The production URL is automatically read from .env.production during releases!
VITE_API_BASE_URL=

# ==========================================
# DATABASE & AUTH (Supabase)
# ==========================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# ==========================================
# SOCIAL LOGIN (Google)
# ==========================================
# Google OAuth *Web* client ID (from Google Cloud Console). Used by the native
# Google Sign-In flow on Android as the token audience / serverClientId. Must be
# the same Web client ID configured as the Google provider in Supabase Auth.
VITE_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id

# ==========================================
# MONETIZATION (RevenueCat)
# ==========================================
VITE_REVENUECAT_ANDROID_API_KEY=your_test_revenuecat_api_key

# ==========================================
# ADS (Google AdMob)
# ==========================================
# Banner/MEDIUM_RECTANGLE ad unit id for the freemium extraction ad.
# Leave EMPTY to serve Google's TEST ads (test mode). Set the real
# ca-app-pub-xxx/yyy id only for production builds. The AdMob *app* id lives
# natively in android/app/src/main/AndroidManifest.xml, not here.
VITE_ADMOB_BANNER_ID=

# Rewarded video ad unit id (empty = Google TEST rewarded ad).
VITE_ADMOB_REWARDED_ID=

# Interstitial ad unit id — used for the full-screen "app-open" ad shown once
# on cold start for free users (frequency-capped, skipped on first launch).
# Leave EMPTY in production to DISABLE the app-open ad entirely (we won't serve
# Google's TEST interstitial to real users). In test/dev builds the TEST unit
# is used automatically.
VITE_ADMOB_INTERSTITIAL_ID=

# Comma-separated AdMob test-device IDs (grab from the "setTestDeviceIds(...)"
# logcat line on first ad load). With this set alongside the real ad IDs, the
# SDK serves TEST ads to these devices — so you can verify the production
# config and safely tap ads. Leave EMPTY in production.
VITE_ADMOB_TEST_DEVICES=
