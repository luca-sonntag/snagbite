# ==============================================================================
# FRONTEND — ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy to `frontend/.env` for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API & SERVER CONNECTIONS
# ------------------------------------------------------------------------------
# Backend API origin. Leave EMPTY for local dev (uses Vite proxy).
# The production URL is automatically read from .env.production during releases!
VITE_API_BASE_URL=
# Website origin for external admin & marketing links
VITE_WEBSITE_URL=http://localhost:5174

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SOCIAL LOGIN (Google OAuth)
# ------------------------------------------------------------------------------
# Google OAuth *Web* client ID (from Google Cloud Console). Used by the native
# Google Sign-In flow on Android as the token audience / serverClientId.
VITE_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id

# Optional dev test-user auto-login (keep password in .env.local)
# VITE_TEST_LOGIN=false
# VITE_TEST_USER_EMAIL=test@dev.snagbite.local
# VITE_TEST_USER_PASSWORD=

# ------------------------------------------------------------------------------
# 3. MONETIZATION — SUBSCRIPTIONS (RevenueCat)
# ------------------------------------------------------------------------------
VITE_REVENUECAT_ANDROID_API_KEY=your_test_revenuecat_api_key

# ------------------------------------------------------------------------------
# 4. MONETIZATION — ADS (Google AdMob)
# ------------------------------------------------------------------------------
# Banner/MEDIUM_RECTANGLE ad unit id for the freemium extraction ad.
# Leave EMPTY to serve Google's TEST ads. The AdMob *app* id lives natively
# in android/app/src/main/AndroidManifest.xml.
VITE_ADMOB_BANNER_ID=

# Rewarded video ad unit id (empty = Google TEST rewarded ad)
VITE_ADMOB_REWARDED_ID=

# Rewarded interstitial ad unit id (optional)
# VITE_ADMOB_REWARDED_INTERSTITIAL_ID=

# Interstitial ad unit id for the full-screen extraction & app-open ads.
# Leave EMPTY in production to disable if not configured.
VITE_ADMOB_INTERSTITIAL_ID=

# Comma-separated AdMob test-device IDs (serves safe TEST ads on registered devices)
VITE_ADMOB_TEST_DEVICES=

# Force Google's public TEST ad unit IDs (100% fill rate, safe for local testing).
# Set to 'true' during testing/development, 'false' in production.
VITE_ADMOB_USE_TEST_ADS=false
