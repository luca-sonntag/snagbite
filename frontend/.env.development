# ==============================================================================
# FRONTEND — DEV / PREVIEW MODE (.env.development)
# ==============================================================================
# Used by `npm run build:dev` and `npm run dev` (Vite `--mode development`) for
# the shared Railway dev environment (dev backend + dev Postgres).
#
# Do NOT put secrets in this committed file — place local credentials in
# `.env.local` or `.env.development.local` (git-ignored).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API & SERVER CONNECTIONS
# ------------------------------------------------------------------------------
# Hosted dev backend origin (leave empty locally to use Vite proxy to :3000)
VITE_API_BASE_URL=https://cookbook-development.up.railway.app
# Website origin for external admin & marketing links
VITE_WEBSITE_URL=https://dev.snagbite.app

# ------------------------------------------------------------------------------
# 2. DEV TEST USER & AUTO-LOGIN
# ------------------------------------------------------------------------------
# Auto-login as the seeded test user (NEVER set in production / Play Store builds)
VITE_TEST_USER_EMAIL=test@dev.snagbite.local
# Keep password in git-ignored .env.local / .env.development.local:
# VITE_TEST_USER_PASSWORD=

# ------------------------------------------------------------------------------
# 3. OPTIONAL DEV AD TIMING OVERRIDES
# ------------------------------------------------------------------------------
# App-open ad timing overrides (milliseconds, default 4h in code).
# Example for quick testing (~5s):
# VITE_APP_OPEN_MIN_INTERVAL_MS=5000
# VITE_APP_OPEN_RESUME_MIN_BG_MS=5000
