# ==========================================
# PRODUCTION CONFIGURATION
# ==========================================
# This file is automatically used by Vite during "npm run build" or releases.
# Values here overwrite the ones in .env!

# ==========================================
# API & SERVER CONNECTIONS
# ==========================================
# Production backend API origin
VITE_API_BASE_URL=https://cookbook-production-8769.up.railway.app

# ==========================================
# SUPABASE (snagbite-prod)
# ==========================================
# Pinned here so production builds never inherit the dev project from a local
# .env — the backend verifies JWTs against snagbite-prod, so a bundle built
# against any other project gets 401 on every authenticated endpoint.
# URL + publishable key are public by design (same as .env.development).
VITE_SUPABASE_URL=https://dwihmvfanfnuxullwhyf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_FZuodYYBnLYsK949Q_NJeg_YhxhpAlL

# ==========================================
# MONETIZATION (RevenueCat)
# ==========================================
# Production RevenueCat API Key
VITE_REVENUECAT_ANDROID_API_KEY=goog_LCrbxAAJUWjsuHbZRXcZGixLXWU

# ==========================================
# ADS (Google AdMob)
# ==========================================
# TODO: set the real production banner ad unit id before enabling live ads.
# While empty the app stays in AdMob test mode (test ads only). Also replace the
# TEST APPLICATION_ID in android/app/src/main/AndroidManifest.xml with the real one.
VITE_ADMOB_BANNER_ID=

