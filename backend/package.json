{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --inspect src/index.ts",
    "dev:brk": "tsx watch --inspect-brk src/index.ts",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "preview": "node dist/index.js",
    "test": "node --import tsx --test src/**/*.test.ts",
    "seed:dev": "tsx src/scripts/seed/seedDev.ts",
    "seed:reviewer": "tsx src/scripts/seed/seedReviewerAccount.ts",
    "seed:reviewer:prod": "tsx src/scripts/seed/seedReviewerAccount.ts --prod",
    "seed:reviewer:dev": "tsx src/scripts/seed/seedReviewerAccount.ts --dev",
    "db:backup": "tsx src/scripts/db/backupDatabase.ts",
    "db:backup:prod": "tsx src/scripts/db/backupDatabase.ts --prod",
    "db:backup:dev": "tsx src/scripts/db/backupDatabase.ts --dev",
    "db:restore": "tsx src/scripts/db/restoreDatabase.ts",
    "db:restore:prod": "tsx src/scripts/db/restoreDatabase.ts --prod",
    "db:restore:dev": "tsx src/scripts/db/restoreDatabase.ts --dev",
    "db:purge-frames": "tsx src/scripts/db/purgeHostedFrames.ts",
    "backfill:covers": "tsx src/scripts/backfill/backfillPublicRecipeCovers.ts",
    "backfill:covers:prod": "tsx src/scripts/backfill/backfillPublicRecipeCovers.ts --prod",
    "backfill:covers:dev": "tsx src/scripts/backfill/backfillPublicRecipeCovers.ts --dev",
    "backfill:nutrition": "tsx src/scripts/backfill/recomputeRecipeNutrition.ts",
    "backfill:nutrition:prod": "tsx src/scripts/backfill/recomputeRecipeNutrition.ts --prod",
    "backfill:nutrition:dev": "tsx src/scripts/backfill/recomputeRecipeNutrition.ts --dev",
    "backfill:mappings": "tsx src/scripts/backfill/backfillIngredientMappings.ts",
    "backfill:consolidate": "tsx src/scripts/backfill/consolidateMappingsToCanonical.ts",
    "backfill:off-index": "tsx src/scripts/backfill/buildOpenFoodFactsIndex.ts",
    "icons:generate": "tsx src/scripts/icons/generateIngredientImage.ts",
    "icons:missing": "tsx src/scripts/icons/generateMissingIngredientIcons.ts",
    "icons:zip": "tsx src/scripts/icons/zipIngredientIcons.ts",
    "icons:unpack": "tsx src/scripts/icons/zipIngredientIcons.ts --unpack",
    "covers:backfill": "npm run backfill:covers",
    "covers:backfill:prod": "npm run backfill:covers:prod",
    "covers:backfill:dev": "npm run backfill:covers:dev",
    "recompute-nutrition": "npm run backfill:nutrition",
    "recompute-nutrition:prod": "npm run backfill:nutrition:prod",
    "recompute-nutrition:dev": "npm run backfill:nutrition:dev",
    "mappings:backfill": "npm run backfill:mappings",
    "mappings:consolidate": "npm run backfill:consolidate",
    "build:off": "npm run backfill:off-index",
    "purge-hosted-frames": "npm run db:purge-frames",
    "generate:ingredient-image": "npm run icons:generate",
    "icons:generate-missing": "npm run icons:missing"
  },
  "dependencies": {
    "@bgbuster/sdk": "^0.0.2",
    "@cookbook/shared": "*",
    "@google/generative-ai": "^0.11.0",
    "@supabase/supabase-js": "^2.108.2",
    "adm-zip": "^0.6.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "fuse.js": "^7.5.0",
    "helmet": "^8.2.0",
    "jose": "^6.2.3",
    "minisearch": "^7.2.0",
    "sharp": "^0.32.6",
    "youtube-dl-exec": "^3.1.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20.14.2",
    "cross-env": "^10.1.0",
    "tsx": "^4.15.2",
    "typescript": "^5.4.5"
  }
}
