{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --inspect src/index.ts",
    "dev:brk": "tsx watch --inspect-brk src/index.ts",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "preview": "node dist/index.js",
    "purge-hosted-frames": "tsx src/scripts/purgeHostedFrames.ts",
    "recompute-nutrition": "tsx src/scripts/recomputeRecipeNutrition.ts",
    "recompute-nutrition:prod": "tsx src/scripts/recomputeRecipeNutrition.ts --prod",
    "recompute-nutrition:dev": "tsx src/scripts/recomputeRecipeNutrition.ts --dev",
    "covers:backfill": "tsx src/scripts/backfillPublicRecipeCovers.ts",
    "covers:backfill:prod": "tsx src/scripts/backfillPublicRecipeCovers.ts --prod",
    "covers:backfill:dev": "tsx src/scripts/backfillPublicRecipeCovers.ts --dev",
    "seed:dev": "tsx src/scripts/seedDev.ts",
    "seed:reviewer": "tsx src/scripts/seedReviewerAccount.ts",
    "seed:reviewer:prod": "tsx src/scripts/seedReviewerAccount.ts --prod",
    "seed:reviewer:dev": "tsx src/scripts/seedReviewerAccount.ts --dev",
    "eval:dry-run": "tsx src/scripts/runDryRunEvaluation.ts",
    "generate:ingredient-image": "tsx src/scripts/generateIngredientImage.ts",
    "icons:zip": "tsx src/scripts/zipIngredientIcons.ts",
    "icons:unpack": "tsx src/scripts/zipIngredientIcons.ts --unpack",
    "icons:generate-missing": "tsx src/scripts/generateMissingIngredientIcons.ts",
    "mappings:backfill": "tsx src/scripts/backfillIngredientMappings.ts",
    "mappings:consolidate": "tsx src/scripts/consolidateMappingsToCanonical.ts",
    "migrate:flatten-ingredients": "tsx src/scripts/migrateFlattenIngredients.ts",
    "migrate:flatten-ingredients:prod": "tsx src/scripts/migrateFlattenIngredients.ts --prod",
    "migrate:flatten-ingredients:dev": "tsx src/scripts/migrateFlattenIngredients.ts --dev",
    "db:backup": "tsx src/scripts/backupDatabase.ts",
    "db:backup:prod": "tsx src/scripts/backupDatabase.ts --prod",
    "db:backup:dev": "tsx src/scripts/backupDatabase.ts --dev",
    "db:restore": "tsx src/scripts/restoreDatabase.ts",
    "db:restore:prod": "tsx src/scripts/restoreDatabase.ts --prod",
    "db:restore:dev": "tsx src/scripts/restoreDatabase.ts --dev",
    "icons": "tsx src/scripts/auditIngredientPipeline.ts",
    "audit:ingredients": "tsx src/scripts/auditIngredientPipeline.ts",
    "audit:test": "tsx src/scripts/testRecipeAuditor.ts",
    "build:off": "tsx src/scripts/buildOpenFoodFactsIndex.ts",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@bgbuster/sdk": "^0.0.2",
    "@cookbook/shared": "*",
    "@google/generative-ai": "^0.11.0",
    "@supabase/supabase-js": "^2.108.2",
    "adm-zip": "^0.6.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "fuse.js": "^7.5.0",
    "helmet": "^8.2.0",
    "jose": "^6.2.3",
    "minisearch": "^7.2.0",
    "sharp": "^0.32.6",
    "youtube-dl-exec": "^3.1.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20.14.2",
    "cross-env": "^10.1.0",
    "tsx": "^4.15.2",
    "typescript": "^5.4.5"
  }
}
