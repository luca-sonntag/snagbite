# ==============================================================================
# BACKEND — ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Complete reference of ALL supported environment variables and their defaults.
# Copy to .env (base defaults) and .env.development / .env.production (secrets).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Port the Express server listens on (default: 3000)
PORT=3000

# Process role: 'web' (API only) | 'worker' (background processor only) | 'both' (monolith)
# Default: both
ROLE=both

# Allowed CORS origins (comma-separated, leave empty to allow all / default origin)
CORS_ORIGIN=

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL & Drizzle ORM)
# ------------------------------------------------------------------------------
# Primary PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/cookbook

# Optional public proxy URL for local CLI migrations/backfills against managed DBs (e.g. Railway)
DATABASE_PUBLIC_URL=

# PostgreSQL connection pool timeout in milliseconds (default: 15000)
DB_CONNECTION_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & ADMIN (Better-Auth & Google OAuth)
# ------------------------------------------------------------------------------
# Public backend URL used by Better-Auth for callbacks and session validation
APP_URL=http://localhost:3000

# Secret key for signing Better-Auth sessions/tokens (minimum 32 characters)
BETTER_AUTH_SECRET=your_better_auth_secret_minimum_32_characters

# Fallback secret for legacy/JWT token validation (optional alias for BETTER_AUTH_SECRET)
JWT_SECRET=

# Google OAuth Web client credentials (for Google login flow)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Comma-separated list of user emails granted admin dashboard access
ADMIN_EMAILS=snagbite.app@gmail.com

# Test user credentials for development seeding scripts
SEED_TEST_USER_EMAIL=test@dev.snagbite.local
SEED_TEST_USER_PASSWORD=snagbite-dev-test-2026

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE (AWS / Railway Tigris S3)
# ------------------------------------------------------------------------------
# S3 / Tigris endpoint (AWS standard)
AWS_ENDPOINT_URL_S3=https://t3.storage.dev

# Storage region (default: auto)
AWS_REGION=auto

# S3 access credentials
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Storage bucket name (injected as BUCKET_NAME by Railway Tigris plugin)
BUCKET_NAME=

# Force path style URLs (default: false for Tigris / AWS S3)
AWS_S3_FORCE_PATH_STYLE=false

# Optional public CDN domain or URL (e.g. https://cdn.your-cookbook.com)
# AWS_PUBLIC_DOMAIN=
# AWS_PUBLIC_URL=

# Optional streaming origin for video streaming
STORAGE_STREAMING_URL=

# ------------------------------------------------------------------------------
# 5. RECIPE & LOCALIZATION DEFAULTS
# ------------------------------------------------------------------------------
# Default target language for recipe extraction and generation (default: German)
RECIPE_LANGUAGE=German

# Preferred temperature unit: Celsius | Fahrenheit | both (default: Celsius)
PREFERRED_TEMPERATURE_UNIT=Celsius

# Preferred unit system: metric (grams, ml, kg) | imperial (oz, cups, lbs, fl oz)
PREFERRED_UNIT_SYSTEM=metric

# ------------------------------------------------------------------------------
# 6. AI & LLM (Google Gemini)
# ------------------------------------------------------------------------------
# Google Gemini API key (required)
GEMINI_API_KEY=your_gemini_api_key

# Primary Gemini model for multimodal extraction and text generation (default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Model used by the tool-using ingredient resolver (default: gemini-3.1-flash-lite)
GEMINI_RERANKER_MODEL=gemini-3.1-flash-lite

# Gemini temperature setting (default: 0)
GEMINI_TEMPERATURE=0

# ------------------------------------------------------------------------------
# 7. INGREDIENT RESOLUTION & AUDIT
# ------------------------------------------------------------------------------
# Kill switch for canonical ingredient resolver (default: true)
INGREDIENT_RESOLVER_ENABLED=true

# Maximum tool-calling turns the resolver may spend on one ingredient (default: 5)
INGREDIENT_RESOLVER_MAX_TURNS=5

# Concurrent resolver calls in flight across the whole process (default: 6)
INGREDIENT_RESOLVER_CONCURRENCY=6

# Verbose debug logging for recipe auditor in development (default: false)
DEBUG_AUDIT=false

# ------------------------------------------------------------------------------
# 8. JEV & CAPTION FAST-TRACK (OpenRouter / TypeSafe)
# ------------------------------------------------------------------------------
# Master toggle for JEV fast-track caption pre-flight (default: true)
JEV_ENABLED=true

# Model for JEV Decisions API (default: typesafe/jev-1.13)
JEV_MODEL=typesafe/jev-1.13

# OpenRouter API key for JEV-1.13 decisions or general fallback
OPENROUTER_API_KEY=

# Direct TypeSafe API key for JEV-1.13 decisions (alternative to OpenRouter)
TYPESAFE_API_KEY=

# ------------------------------------------------------------------------------
# 9. AI IMAGE GENERATION & PROCESSING (fal.ai FLUX.1 / bgbuster)
# ------------------------------------------------------------------------------
# Master toggle for generating AI food photography covers during extraction & remix (default: true)
GENERATE_RECIPE_COVERS=true

# fal.ai API key for FLUX.1 AI food photography (alias: FLUX_API_KEY)
FAL_KEY=your_fal_api_key
FLUX_API_KEY=

# bgbuster API key for background removal on ingredient icons (optional)
BGBUSTER_API_KEY=

# ------------------------------------------------------------------------------
# 10. AUDIO TRANSCRIPTION (Cloudflare Whisper Proxy)
# ------------------------------------------------------------------------------
# Public Cloudflare Worker endpoint for audio transcription
CLOUDFLARE_WHISPER_ENDPOINT=https://snagbite-whisper-proxy.snagbite.workers.dev

# Shared HMAC secret used to sign/verify ephemeral client whisper tickets
WHISPER_HMAC_SECRET=dev-whisper-hmac-secret-change-in-production

# ------------------------------------------------------------------------------
# 11. SCRAPING & METADATA PROVIDERS (RapidAPI & yt-dlp)
# ------------------------------------------------------------------------------
# RapidAPI key for primary social downloader
RAPIDAPI_KEY=your_rapidapi_key

# RapidAPI social host (default: social-download-all-in-one.p.rapidapi.com)
RAPIDAPI_SOCIAL_HOST=social-download-all-in-one.p.rapidapi.com

# Optional yt-dlp cookie configuration to bypass bot checks in dev (e.g. 'chrome', 'firefox')
YTDLP_COOKIES_FROM_BROWSER=

# Path to Netscape cookie file (defaults to cookies.txt if present)
YTDLP_COOKIES_FILE=

# ------------------------------------------------------------------------------
# 12. MONETIZATION & SUBSCRIPTIONS (RevenueCat)
# ------------------------------------------------------------------------------
# RevenueCat REST API secret key (starts with sk_)
REVENUECAT_SECRET_KEY=sk_example

# ------------------------------------------------------------------------------
# 13. QUEUE & WORKER CONCURRENCY
# ------------------------------------------------------------------------------
# Number of concurrent jobs processed per worker instance (default: 3)
WORKER_CONCURRENCY=3

# Job lease timeout before an uncompleted job is reclaimed (minutes, default: 10)
WORKER_LEASE_TIMEOUT_MINUTES=10

# Timeout before a job stuck in awaiting_frames reverts to caption-only (minutes, default: 5)
CLIENT_FRAMES_TIMEOUT_MINUTES=5

# Maximum active jobs allowed per user simultaneously (default: 3)
MAX_JOBS_PER_USER=3

# Max in-flight extractions a free user may run concurrently (default: 1)
FREE_MAX_CONCURRENT_EXTRACTIONS=1

# Max in-flight extractions a premium/alpha user may run concurrently (default: 3)
PREMIUM_MAX_CONCURRENT_EXTRACTIONS=3

# Reject videos longer than this before downloading (seconds, 0 = unlimited, default: 90)
MAX_VIDEO_DURATION_SECONDS=90

# ------------------------------------------------------------------------------
# 14. USAGE LIMITS, QUOTAS & ALPHA TIER
# ------------------------------------------------------------------------------
# Timeframe window in days for rolling rate limits (default: 1)
EXTRACTION_LIMIT_WINDOW_DAYS=1

# Free tier limits
FREE_MAX_EXTRACTIONS_PER_WINDOW=3
FREE_MAX_SAVED_RECIPES=10

# Premium tier limits
PREMIUM_MAX_EXTRACTIONS_PER_WINDOW=30

# Alpha tier configuration (-1 = unlimited saved recipes)
ALPHA_ACTIVE=false
ALPHA_MAX_EXTRACTIONS_PER_WINDOW=10
ALPHA_MAX_SAVED_RECIPES=20

# ------------------------------------------------------------------------------
# 15. SMART AI PUSH NOTIFICATIONS (Firebase FCM)
# ------------------------------------------------------------------------------
# Master switch for the AI push-notification worker (default: false)
NOTIFICATIONS_ENABLED=false

# Firebase project id that owns the FCM app
FCM_PROJECT_ID=

# Firebase service-account credentials: raw single-line JSON string or path to JSON file
FCM_SERVICE_ACCOUNT_JSON=

# Worker check interval (minutes, default: 15)
NOTIFICATION_TICK_MINUTES=15

# Local-time evening send window start hour: 0-23 (default: 17)
NOTIFICATION_SEND_WINDOW_START=17

# Local-time evening send window end hour: 0-23 (default: 20)
NOTIFICATION_SEND_WINDOW_END=20

# Hard cap per user per rolling 7 days (default: 3, max 1/day always enforced)
NOTIFICATION_MAX_PER_WEEK=3

# Fallback IANA timezone when user has none set (default: Europe/Vienna)
NOTIFICATION_DEFAULT_TZ=Europe/Vienna

# Generate and log notifications without calling FCM (testing flag, default: false)
NOTIFICATION_DRY_RUN=false

# ------------------------------------------------------------------------------
# 16. OPERATOR ALERTS (ntfy — see backend/src/alerts/)
# ------------------------------------------------------------------------------
# Master switch for operator alerts (default: false)
ALERTS_ENABLED=false

# Alert title prefix override; defaults to [dev] outside production, none in production
ALERTS_ENV_LABEL=

# ntfy server base URL (default: https://ntfy.sh)
NTFY_SERVER_URL=https://ntfy.sh

# Dedicated ntfy topic for operator alerts (separate from healthcheck NTFY_TOPIC)
NTFY_ALERTS_TOPIC=

# Optional auth token for protected/reserved ntfy topics
NTFY_TOKEN=

# Dashboard click URL attached to alert notifications
ALERTS_ADMIN_URL=https://snagbite.app/#/admin

# Include masked e-mails & feedback excerpts in alerts (default: false, data privacy)
ALERTS_INCLUDE_PII=false

# Comma-separated list of event types to mute (e.g. "job.failed,user.deleted")
ALERTS_DISABLED_EVENTS=

# Injected automatically by Railway environment (e.g. "production", "development")
RAILWAY_ENVIRONMENT_NAME=

# ------------------------------------------------------------------------------
# 17. STANDALONE HEALTHCHECK CLI (optional monitoring)
# ------------------------------------------------------------------------------
HEALTHCHECK_WEBSITE_URL=https://your-cookbook-website.com
HEALTHCHECK_BACKEND_URL=https://your-cookbook-backend.com/health
HEALTHCHECK_WHISPER_URL=https://snagbite-whisper-proxy.snagbite.workers.dev
NTFY_TOPIC=your-unique-cookbook-alerts-topic
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
