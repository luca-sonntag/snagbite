# ==============================================================================
# BACKEND — ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy to .env (base defaults) and .env.development / .env.production (secrets).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER
# ------------------------------------------------------------------------------
PORT=3000

# ------------------------------------------------------------------------------
# 2. DATABASE (Railway PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/cookbook
# Optional public proxy URL for local CLI migrations/backfills against Railway
# DATABASE_PUBLIC_URL=

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & ADMIN (Better-Auth & Google OAuth)
# ------------------------------------------------------------------------------
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=your_better_auth_secret_minimum_32_characters
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Comma-separated emails allowed to access the admin dashboard
ADMIN_EMAILS=

# Optional dev test user credentials (used by seeding scripts)
# SEED_TEST_USER_EMAIL=test@dev.snagbite.local
# SEED_TEST_USER_PASSWORD=

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE (S3 / Railway Tigris)
# ------------------------------------------------------------------------------
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# Optional for single-bucket providers like Railway Tigris (e.g. stocked-pannier-0eesyf0wg)
# BUCKET_NAME=
AWS_S3_FORCE_PATH_STYLE=false
# Optional public CDN domain or URL (e.g. https://cdn.your-cookbook.com)
# AWS_PUBLIC_DOMAIN=
# AWS_PUBLIC_URL=

# ------------------------------------------------------------------------------
# 5. RECIPE & LOCALIZATION DEFAULTS
# ------------------------------------------------------------------------------
RECIPE_LANGUAGE=German
# Options: Celsius | Fahrenheit | both
PREFERRED_TEMPERATURE_UNIT=Celsius
# Options: metric (grams, ml, kg) | imperial (oz, cups, lbs, fl oz)
PREFERRED_UNIT_SYSTEM=metric

# ------------------------------------------------------------------------------
# 6. AI & LLM (Google Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_RERANKER_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0

# ------------------------------------------------------------------------------
# 7. JEV & CAPTION FAST-TRACK (OpenRouter / TypeSafe)
# ------------------------------------------------------------------------------
# Master toggle for JEV fast-track caption pre-flight (default: true)
JEV_ENABLED=true
# Model for JEV Decisions API (default: typesafe/jev-1.13)
JEV_MODEL=typesafe/jev-1.13
# OpenRouter API key for JEV-1.13 decisions or general fallback
OPENROUTER_API_KEY=your_openrouter_api_key
# Direct TypeSafe API key for JEV-1.13 decisions (optional alternative to OpenRouter)
TYPESAFE_API_KEY=your_typesafe_api_key

# ------------------------------------------------------------------------------
# 8. AI IMAGE GENERATION & PROCESSING (fal.ai / bgbuster)
# ------------------------------------------------------------------------------
# Master toggle for generating AI food photography covers during extraction & remix (default: true)
GENERATE_RECIPE_COVERS=true
# fal.ai API key: generate AI food photography covers and icons
FAL_KEY=your_fal_key_here
# bgbuster API key: remove background from ingredient icons (optional)
BGBUSTER_API_KEY=your_bgbuster_api_key

# ------------------------------------------------------------------------------
# 9. AUDIO TRANSCRIPTION (Cloudflare Whisper Proxy)
# ------------------------------------------------------------------------------
# Public Cloudflare Worker endpoint for audio transcription
CLOUDFLARE_WHISPER_ENDPOINT=https://snagbite-whisper-proxy.snagbite.workers.dev
# Shared HMAC secret used to sign/verify ephemeral client whisper tickets
WHISPER_HMAC_SECRET=dev-whisper-hmac-secret-change-in-production

# ------------------------------------------------------------------------------
# 10. SCRAPING & METADATA PROVIDERS (RapidAPI)
# ------------------------------------------------------------------------------
# Primary provider: "Social Download All In One" on RapidAPI
RAPIDAPI_KEY=your_rapidapi_key

# Optional yt-dlp cookie configuration to bypass bot checks (dev only)
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_FILE=cookies.txt

# ------------------------------------------------------------------------------
# 11. MONETIZATION & SUBSCRIPTIONS (RevenueCat)
# ------------------------------------------------------------------------------
REVENUECAT_SECRET_KEY=sk_example

# ------------------------------------------------------------------------------
# 12. USAGE LIMITS & QUOTAS
# ------------------------------------------------------------------------------
# Timeframe window in days for rolling rate limits
EXTRACTION_LIMIT_WINDOW_DAYS=1

# Free tier limits
FREE_MAX_EXTRACTIONS_PER_WINDOW=3
FREE_MAX_SAVED_RECIPES=5

# Premium tier limits
PREMIUM_MAX_EXTRACTIONS_PER_WINDOW=50

# Reject videos longer than this many seconds before downloading (0 = no limit)
MAX_VIDEO_DURATION_SECONDS=90

# ------------------------------------------------------------------------------
# 13. SMART AI PUSH NOTIFICATIONS (Firebase FCM — optional)
# ------------------------------------------------------------------------------
# Master switch for the AI push-notification worker. Requires FCM_* below.
NOTIFICATIONS_ENABLED=false
# Firebase project id that owns the FCM app (from the Firebase console)
FCM_PROJECT_ID=
# Raw JSON (single line) or path to the service-account .json file
FCM_SERVICE_ACCOUNT_JSON=
# How often the worker checks who is due for a notification (minutes)
NOTIFICATION_TICK_MINUTES=15
# Local-time evening send window (hours, 0-23). One send attempt per user per day.
NOTIFICATION_SEND_WINDOW_START=17
NOTIFICATION_SEND_WINDOW_END=20
# Hard cap per user per rolling 7 days (max 1/day is always enforced)
NOTIFICATION_MAX_PER_WEEK=3
# IANA timezone fallback when a user has not set notification_timezone
NOTIFICATION_DEFAULT_TZ=Europe/Vienna
# When true, generate + log notifications but never actually call FCM
NOTIFICATION_DRY_RUN=false

# ------------------------------------------------------------------------------
# 14. OPERATOR ALERTS (ntfy — see backend/src/alerts/)
# ------------------------------------------------------------------------------
# Master switch for operator alerts (signups, upgrades, feedback, job failures)
ALERTS_ENABLED=false
# Optional title prefix override; defaults to [dev] outside production
ALERTS_ENV_LABEL=
# ntfy server base URL (defaults to https://ntfy.sh)
NTFY_SERVER_URL=https://ntfy.sh
# Dedicated ntfy topic for operator alerts (keep separate from healthcheck NTFY_TOPIC)
NTFY_ALERTS_TOPIC=your-unique-cookbook-admin-alerts
# Optional auth token for protected / reserved ntfy topics
NTFY_TOKEN=
# Optional dashboard click URL
ALERTS_ADMIN_URL=https://snagbite.app/#/admin
# Include masked e-mails and feedback message excerpts in alerts (default: false)
ALERTS_INCLUDE_PII=false
# Comma-separated list of event types to mute (e.g. "job.failed,user.deleted")
ALERTS_DISABLED_EVENTS=

# ------------------------------------------------------------------------------
# 15. STANDALONE HEALTHCHECK CLI (optional)
# ------------------------------------------------------------------------------
HEALTHCHECK_WEBSITE_URL=https://your-cookbook-website.com
HEALTHCHECK_BACKEND_URL=https://your-cookbook-backend.com/health
HEALTHCHECK_WHISPER_URL=https://snagbite-whisper-proxy.snagbite.workers.dev
NTFY_TOPIC=your-unique-cookbook-alerts-topic
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
