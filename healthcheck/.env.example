# ==============================================================================
# HEALTHCHECK — ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Complete reference of ALL supported environment variables for the healthcheck CLI.
# Copy to `healthcheck/.env` to configure the standalone monitoring service.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MONITORED SERVICE ENDPOINTS
# ------------------------------------------------------------------------------
# Public URL of your backend health endpoint to monitor
HEALTHCHECK_BACKEND_URL=https://your-cookbook-backend.com/health

# Public URL of your frontend website to monitor
HEALTHCHECK_WEBSITE_URL=https://your-cookbook-website.com

# Public URL of the Whisper proxy / Cloudflare Worker (alias: CLOUDFLARE_WHISPER_ENDPOINT)
HEALTHCHECK_WHISPER_URL=https://snagbite-whisper-proxy.snagbite.workers.dev
CLOUDFLARE_WHISPER_ENDPOINT=

# ------------------------------------------------------------------------------
# 2. API INTEGRATION CREDENTIALS (Health Probes — optional)
# ------------------------------------------------------------------------------
# If configured, verifies that upstream APIs respond properly with your keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_SOCIAL_HOST=social-download-all-in-one.p.rapidapi.com

# ------------------------------------------------------------------------------
# 3. MOBILE NOTIFICATION CHANNELS (ntfy.sh / Telegram)
# ------------------------------------------------------------------------------
# ntfy.sh topic name for phone push notifications (optional)
NTFY_TOPIC=your-unique-cookbook-alerts-topic

# Telegram bot configuration for notification delivery (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
