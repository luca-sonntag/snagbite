# ==============================================================================
# WEBSITE — ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Complete reference of ALL supported Vite environment variables for the website.
# Copy to `website/.env` for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API & SERVER CONNECTIONS
# ------------------------------------------------------------------------------
# Backend API origin. Leave empty in local dev to use Vite proxy to localhost:3000.
# In production, set to full URL (e.g. https://server.snagbite.app).
VITE_API_BASE_URL=
